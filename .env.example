# Docker Compose defaults. Copy to .env and edit for local container runs.

APP_ENV=production

POSTGRES_DB=ai_code_review
POSTGRES_USER=ai_review_app
POSTGRES_PASSWORD=replace-with-local-postgres-password
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000

# Used by the backend container and Alembic.
DATABASE_URL=postgresql+psycopg://ai_review_app:replace-with-local-postgres-password@postgres:5432/ai_code_review

# Browser-facing API URL baked into the frontend build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Server-side API URL used by Next.js while running inside Docker Compose.
API_INTERNAL_BASE_URL=http://backend:8000/api

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2000

GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_VERSION=2026-03-10
GITHUB_TIMEOUT_SECONDS=20
GITHUB_MAX_FILES=3000
